@model WebApplication3.Web.Models.CreateOrderViewModel
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = "Новый заказ";
    var products = (List<SelectListItem>)ViewBag.Products;
}

<h1>Новый заказ</h1>

<p class="text-muted">
    Для теста: <code>user@example.com</code> — обычный клиент,
    <code>blocked@example.com</code> — заблокированный клиент.
</p>

<form asp-action="Create" method="post" id="order-form">
    @* Общая ошибка формы (из ModelState) *@
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="CustomerEmail" class="form-label">Email клиента</label>
        <input asp-for="CustomerEmail" class="form-control" />
        <span asp-validation-for="CustomerEmail" class="text-danger"></span>
    </div>

    <h3>Товары</h3>

    <table class="table" id="items-table">
        <thead>
            <tr>
                <th>Товар</th>
                <th style="width:150px">Количество</th>
                <th style="width:60px"></th>
            </tr>
        </thead>
        <tbody>
            @for (int i = 0; i < Model.Items.Count; i++)
            {
                <tr>
                    <td>
                        <select asp-for="Items[i].ProductId" asp-items="products" class="form-select"></select>
                        <span asp-validation-for="Items[i].ProductId" class="text-danger"></span>
                    </td>
                    <td>
                        <input asp-for="Items[i].Quantity" type="number" min="1" class="form-control" />
                        <span asp-validation-for="Items[i].Quantity" class="text-danger"></span>
                    </td>
                    <td>
                        <button type="button" class="btn btn-outline-danger btn-sm btn-remove">✕</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <template id="row-template">
        <tr>
            <td>
                <select name="Items[__index__].ProductId" class="form-select">
                    @foreach (var p in products)
                    {
                        <option value="@p.Value">@p.Text</option>
                    }
                </select>
            </td>
            <td>
                <input name="Items[__index__].Quantity" type="number" min="1" value="1" class="form-control" />
            </td>
            <td>
                <button type="button" class="btn btn-outline-danger btn-sm btn-remove">✕</button>
            </td>
        </tr>
    </template>

    <button type="button" id="add-item" class="btn btn-outline-secondary">+ Добавить товар</button>
    <hr />
    <button type="submit" class="btn btn-primary">Создать заказ</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            var form = document.getElementById('order-form');
            var tbody = document.querySelector('#items-table tbody');
            var template = document.getElementById('row-template').innerHTML;

            document.getElementById('add-item').addEventListener('click', function () {
                var index = tbody.querySelectorAll('tr').length;
                tbody.insertAdjacentHTML('beforeend', template.split('__index__').join(index));
            });

            tbody.addEventListener('click', function (e) {
                var btn = e.target.closest('.btn-remove');
                if (btn) btn.closest('tr').remove();
            });

            // Перед отправкой делаем индексы подряд (0,1,2...), иначе биндинг списка обрывается на пропуске
            form.addEventListener('submit', function () {
                tbody.querySelectorAll('tr').forEach(function (tr, i) {
                    tr.querySelectorAll('[name]').forEach(function (el) {
                        el.name = el.name.replace(/Items\[\d+\]/, 'Items[' + i + ']');
                    });
                });
            });
        })();
    </script>
}
